{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for every Vellis window — the startup window ('main') and every window opened at runtime ('vellis-<n>', minted by WindowManager::next_label).",
  "windows": ["main", "vellis-*"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "mailto:*" },
        { "url": "tel:*" }
      ]
    },
    "dialog:default",
    "window-state:default"
  ]
}
