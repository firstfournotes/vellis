{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vellis",
  "version": "0.5.2",
  "identifier": "com.tetsuo.vellis",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "vellis",
        "tabbingIdentifier": "vellis-noroot:main",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: customprotocol: asset:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: vellis-asset: asset: http://asset.localhost tauri: customprotocol:; font-src 'self' data:; media-src 'self' vellis-asset: asset: http://asset.localhost; frame-src 'self' vellis-asset:; connect-src 'self' ipc: http://ipc.localhost vellis-asset: asset: http://asset.localhost tauri: customprotocol:; object-src 'none'; base-uri 'self' vellis-asset:; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "name": "Markdown", "ext": ["md", "markdown", "mdx"], "role": "Viewer", "rank": "Alternate" },
      { "name": "HTML", "ext": ["html", "htm"], "role": "Viewer", "rank": "Alternate" },
      {
        "name": "Image",
        "ext": ["png", "jpg", "jpeg", "gif", "webp", "avif", "bmp", "ico", "svg"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      { "name": "3D Model", "ext": ["stl", "3mf", "obj", "ply"], "role": "Viewer", "rank": "Alternate" },
      { "name": "Video", "ext": ["mp4", "mov", "webm"], "role": "Viewer", "rank": "Alternate" },
      { "name": "Audio", "ext": ["wav", "mp3", "m4a"], "role": "Viewer", "rank": "Alternate" },
      { "name": "PDF", "ext": ["pdf"], "role": "Viewer", "rank": "Alternate" },
      {
        "name": "Text",
        "ext": ["txt"],
        "contentTypes": ["public.text"],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
